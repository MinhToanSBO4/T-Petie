# Supabase PostgreSQL. Never commit real values.
# Local/direct connection; Vercel serverless uses Supabase transaction pooler with pgbouncer=true.
CONNECTION_STRING="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=tpetie_app"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
# Google OAuth is reserved for a later phase.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_USERNAME=""
STAFF_EMAIL=""
STAFF_USERNAME=""
STAFF_INITIAL_PASSWORD=""
API_CDN=""
CDN_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Existing provider naming also supported: CLOUD_NAME, CLOUD_API_SECRET.
CLOUD_NAME=""
CLOUD_API_SECRET=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
