# Supabase PostgreSQL (schema tpetie_app). Never commit real values.
# Local: dùng session pooler (cổng 5432) cho cả hai biến.
# Vercel: CONNECTION_STRING = transaction pooler (cổng 6543) + pgbouncer=true; DIRECT_URL = session pooler (cổng 5432).
# Số kết nối (connection_limit) và thời gian chờ (pool_timeout) được ứng dụng tự chọn theo môi trường nếu không ghi trong chuỗi.
CONNECTION_STRING="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=tpetie_app"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=tpetie_app"

# NextAuth. Production: NEXTAUTH_URL là domain chính thức (https://...), secret tạo bằng `openssl rand -base64 32`.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
# Google OAuth is reserved for a later phase.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Tài khoản quản trị/nhân viên KHÔNG đặt trong file này: tạo quản trị viên bằng `npm run admin:create` (nhập trong terminal), nhân viên trong trang /admin/staff.

# Cloudinary (ảnh và file xuất Excel). Chấp nhận cả tên CLOUD_NAME/CLOUD_API_KEY/CLOUD_API_SECRET.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron/maintenance. Chuỗi ngẫu nhiên ≥ 16 ký tự.
CRON_SECRET=""

# Public measurement IDs; never put API secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
