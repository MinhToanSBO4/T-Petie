# Supabase PostgreSQL (schema tpetie_app). Never commit real values.
# Local: use the session pooler (port 5432) for both URLs.
# Vercel: CONNECTION_STRING = transaction pooler (port 6543) + pgbouncer=true; DIRECT_URL = session pooler (port 5432).
# The application selects connection_limit and pool_timeout for the environment unless the URL specifies them.
CONNECTION_STRING="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=tpetie_app"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=tpetie_app"

# NextAuth. Production: set NEXTAUTH_URL to the HTTPS site origin; generate a secret with `openssl rand -base64 32`.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
# Optional Google sign-in: enabled when both values are set (callback URL: <NEXTAUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Do not configure admin or staff accounts here. Run `npm run admin:create` interactively; create staff at /admin/staff.

# Cloudinary (images and Excel exports). CLOUD_NAME/CLOUD_API_KEY/CLOUD_API_SECRET are accepted aliases.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/maintenance. Use a random value of at least 16 characters.
CRON_SECRET=""

# Public measurement IDs; never put API secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Transactional SMTP. Only use a sender mailbox/alias authorized by the SMTP provider.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-smtp-account@example.com"
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="your-smtp-account@example.com"
MAIL_FROM_NAME="T'Petie · No Reply"
MAIL_BRAND_NAME="T'Petie"
MAIL_REPLY_TO=""
MAIL_SITE_URL="http://localhost:3000"
