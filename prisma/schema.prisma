// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("CONNECTION_STRING")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  username      String?   @unique
  password      String?   // Hashed with bcrypt (nullable cho Google OAuth)
  role          String    @default("user") // "admin" | "user"
  
  // Thông tin mở rộng cho hồ sơ Mẹ & Bé
  name          String?
  emailVerified DateTime?
  image         String?
  status        String    @default("active") // "active" | "blocked"
  phone         String?
  address       String?
  city          String?
  points        Int       @default(0)        // Chương trình điểm thưởng chưa kích hoạt
  
  // Hồ sơ Bé Yêu & Gợi ý Size tự động
  babyName        String?
  babyBirthDate   DateTime?
  babyWeight      Float?                     // kg
  babyHeight      Float?                     // cm
  babyGender      String?   @default("be-gai")
  recommendedSize String?                    // VD: "Size 2 (10 - 12kg)"

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?

  @@map("users")
}

model Product {
  id String @id @default(cuid())
  sku String @unique
  slug String @unique
  name String
  categoryId String?
  collectionId String?
  categoryName String @default("")
  subcategory String?
  subcategoryName String?
  material String @default("")
  materialFeatures String[] @default([])
  description String? @db.Text
  specifications String? @db.Text
  promotion String?
  orderNote String?
  careInstructions String[] @default([])
  origin String @default("Việt Nam")
  colorName String?
  colorHex String?
  basePrice BigInt
  originalPrice BigInt?
  discountPercent Int @default(0)
  saleCampaign String?
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)
  isSale Boolean @default(false)
  isActive Boolean @default(true)
  rating Float?
  reviewCount Int @default(0)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images ProductImage[]
  variants ProductVariant[]
  reviews ProductReview[]
  orderItems OrderItem[]
  testimonials CustomerTestimonial[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([collectionId, isActive])
  @@index([isActive, createdAt])
  @@map("products")
}

model CommerceSetting {
  id String @id
  shippingFee BigInt
  freeShippingThreshold BigInt
  updatedAt DateTime @updatedAt
  @@map("commerce_settings")
}

model Coupon {
  code String @id
  type String
  value Int
  minSubtotal BigInt @default(0)
  active Boolean @default(true)
  requiresLogin Boolean @default(false)
  startsAt DateTime?
  expiresAt DateTime?
  usageLimit Int?
  usedCount Int @default(0)
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("coupons")
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  imageUrl String?
  parentId String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("categories")
}

model Collection {
  id String @id @default(cuid())
  slug String @unique
  title String
  subtitle String?
  story String? @db.Text
  bannerUrl String
  lookbookUrls String[] @default([])
  themeColor String?
  accentColor String?
  season String?
  badge String?
  isActive Boolean @default(true)
  showInMenu Boolean @default(true)
  showOnHome Boolean @default(true)
  sortOrder Int @default(0)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("collections")
}

/// Đánh giá sản phẩm của khách đã mua: mỗi món trong đơn đã hoàn tất được đánh giá một lần và sửa tối đa một lần.
/// Quản trị viên duyệt trước khi hiển thị và chọn đánh giá nổi bật cho trang chủ.
model ProductReview {
  id           String   @id @default(cuid())
  productId    String
  userId       String?
  /// Món đã mua được đánh giá; null chỉ với đánh giá cũ trước khi có xác minh mua hàng.
  orderItemId  String?  @unique
  customerName String
  /// Khách chọn ẩn tên: trang công khai chỉ hiện tên đã che.
  isAnonymous  Boolean  @default(false)
  rating       Int
  /// Có thể để trống khi khách chỉ chấm sao.
  content      String   @db.Text
  /// Kích cỡ khách đã mua, hiển thị như "Phân loại" trên đánh giá.
  variantLabel String?
  /// Cảm nhận về kích cỡ: "small" | "fit" | "large".
  sizeFit      String?
  imageUrls    String[] @default([])
  editCount    Int      @default(0)
  /// Đánh giá hiển thị ngay khi khách gửi; quản trị viên/nhân viên có thể ẩn đánh giá không phù hợp.
  isHidden     Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  /// Phản hồi của shop, hiện ngay dưới đánh giá trên trang sản phẩm.
  reply        String?  @db.Text
  repliedAt    DateTime?
  repliedById  String?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([productId, isHidden])
  @@index([isFeatured, isHidden])
  @@index([userId])
  @@map("product_reviews")
}

/// Feedback khách hàng dạng ảnh chụp màn hình tin nhắn khen shop.
/// Chỉ bản đã xác nhận khách đồng ý và bật công bố mới hiển thị công khai.
model CustomerTestimonial {
  id String @id @default(cuid())
  /// Ảnh trong thư viện media (Cloudinary).
  imageUrl String
  imageWidth Int?
  imageHeight Int?
  /// Chú thích ngắn tùy chọn, ví dụ "Mẹ bé Na · Hà Nội"; đồng thời là mô tả ảnh cho trình đọc màn hình.
  caption String?
  /// Sản phẩm được khen trong feedback, hiện nút xem sản phẩm khi xem feedback.
  productId String?
  sortOrder Int @default(0)
  consentConfirmed Boolean @default(false)
  isPublished Boolean @default(false)
  createdById String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isPublished, sortOrder])
  @@map("customer_testimonials")
}

model SiteContent {
  key String @id
  data Json
  updatedAt DateTime @updatedAt
  @@map("site_content")
}

/// Thư viện ảnh dùng chung: mọi ảnh hiển thị trên website đều có bản ghi tại đây.
/// Ảnh được lưu trên Cloudinary, database giữ metadata và URL phân phối.
model MediaAsset {
  id           String   @id @default(cuid())
  url          String   @unique
  publicId     String?  @unique
  folder       String   @default("tpetie/site")
  altText      String?
  width        Int?
  height       Int?
  bytes        Int?
  format       String?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([createdAt])
  @@map("media_assets")
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  url String
  altText String?
  isPrimary Boolean @default(false)
  sortOrder Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  sku String @unique
  size String
  weightRange String?
  ageRange String?
  price BigInt
  stock Int @default(0)
  isActive Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, size])
  @@map("product_variants")
}

model Order {
  id String @id @default(cuid())
  orderCode String @unique
  userId String?
  idempotencyKey String? @unique
  customerName String
  customerPhone String
  customerEmail String?
  shippingAddress String
  city String
  district String
  ward String?
  orderNote String? @db.Text
  source String? // Kênh khách biết đến cửa hàng, do khách chọn khi thanh toán
  subtotal BigInt
  shippingFee BigInt @default(0)
  discountAmount BigInt @default(0)
  couponCode String?
  totalAmount BigInt
  currency String @default("VND")
  paymentMethod String @default("COD")
  paymentStatus String @default("PENDING")
  orderStatus String @default("PENDING")
  /// Thời điểm đơn chuyển sang Hoàn tất; mốc tính hạn đánh giá sản phẩm.
  completedAt DateTime?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon? @relation(fields: [couponCode], references: [code], onDelete: SetNull)
  items OrderItem[]
  statusEvents OrderStatusEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
  @@map("orders")
}

/// Lịch sử chuyển trạng thái đơn, dùng cho dòng thời gian "hành trình đơn hàng" của khách.
model OrderStatusEvent {
  id String @id @default(cuid())
  orderId String
  status String
  /// Ai chuyển trạng thái: admin, customer (khách tự hủy/xác nhận đã nhận) hoặc system (tự hoàn tất).
  actor String?
  /// Ghi chú hiển thị trong lịch sử đơn, ví dụ lý do hủy.
  note String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  variantId String
  productName String
  sku String
  size String
  quantity Int
  unitPrice BigInt
  totalPrice BigInt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review ProductReview?
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Tiến trình xuất dữ liệu chạy nền: người dùng kích hoạt rồi nhận thông báo khi file sẵn sàng.
model ExportJob {
  id            String    @id @default(cuid())
  status        String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  requestedById String?
  fileName      String?
  fileUrl       String?
  orderCount    Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  @@index([createdAt])
  @@map("export_jobs")
}

model RateLimitCounter {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
